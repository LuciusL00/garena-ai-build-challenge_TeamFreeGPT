{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@adaptive-input": ["./packages/adaptive-input/src/index.ts"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["app", "demos/swarmfall/src", "packages/adaptive-input/src"]
}
